# Copy this file to .env and fill in real values. NEVER put real credentials here:
# .env is git-ignored, .env.example is committed.
MONGO_URI=mongodb://127.0.0.1:27017/placement_portal
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional: used by "npm run seed:superadmin"
SUPER_ADMIN_EMAIL=superadmin@iiits.in
SUPER_ADMIN_PASSWORD=change_me_before_using
SUPER_ADMIN_NAME=Placement Officer
